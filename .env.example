# 复制成 .env 即可:cp .env.example .env
# docker compose 会自动读取同目录下的 .env,文件不存在也不会报错。

# --- 应用 ---
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=3000
# 注意:API_PORT 改端口时,NEXT_PUBLIC_API_BASE_URL 要跟着改

# 容器以你的 UID 运行,避免它写出的文件在宿主机上属于 root、删不掉
# 用 `id -u` / `id -g` 确认
HOST_UID=1000
HOST_GID=1000

# --- 数据库 ---
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=guardrail
POSTGRES_DB=guardrail
POSTGRES_PORT=5432
# 本地直接连宿主机
DATABASE_URL=postgresql+asyncpg://guardrail:guardrail@localhost:5432/guardrail
# 容器内互连(compose 会用它覆盖上面的值)
DATABASE_URL_IN_DOCKER=postgresql+asyncpg://guardrail:guardrail@postgres:5432/guardrail

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_URL_IN_DOCKER=redis://redis:6379/0

# --- 前端 ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://api:8000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- 治理层(W2 起启用)---
LEASE_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
MAX_STEP_RETRIES=3

# --- 规划器(W3)---
# deterministic:规则解析,离线可跑,CI 默认走这个
# llm:走 OpenAI 兼容接口,输出仍会被工具 Schema 校验一遍
# 想看真模型跑规划器:填好下面的 LLM_*,然后 `make demo-planner`(会消耗 token)
PLANNER_BACKEND=deterministic
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_REPAIR_ATTEMPTS=2

# --- 策略引擎(W3)---
# 信任等级授予给**执行体**,不是给某次操作打的危险分;危险分是工具的 risk_level。
# L0 只读 / L1 建议 / L2 低风险可逆自动 / L3 低风险自动+高风险逐笔审批 / L4 额度内受限自主
POLICY_DEFAULT_TRUST_LEVEL=L2
# 按执行体单独授权,逗号分隔。没列出的一律走默认档
# POLICY_ACTOR_TRUST_LEVELS=agent:refund-bot=L4,human:operator-01=L3
# 只有 L4 用得上:高风险工具在「幂等 + 可补偿 + 未超此额度」时可以自动执行
POLICY_L4_HIGH_RISK_LIMIT_CENTS=20000
# 是否允许机器执行体(agent: 前缀)批准人工审批步骤。默认 false:
# 让机器人给同类签字,等于把审批这道闸门拆了。打开前想清楚谁负责。
# POLICY_ALLOW_AGENT_APPROVAL=false
# 双人复核阈值(分):超过它的高风险操作要两个**不同角色**先后签字。
# 金额未知的高风险操作一律按超阈值处理 —— 不知道要动多少钱,就别让一个人拍板。
POLICY_DUAL_APPROVAL_THRESHOLD_CENTS=10000
# 审批人 -> 角色。不配的话每个人自成一种角色(必须换个人签字才有效);
# 配了才知道「两个主管互相签字不算双人复核」这种组织约束。
# POLICY_APPROVER_ROLES=supervisor-01=supervisor,supervisor-02=supervisor,finance-01=finance

# --- 补偿 Saga(W6)---
# auto:失败后立刻按工具声明的补偿动作逆序补偿
# manual:留失败现场,等人点「撤销这次执行」(补偿动作本身在低信任等级下需要人工确认)
# off:不补偿,只留失败现场
COMPENSATION_MODE=auto

# --- 身份(W8)---
# 演示账号(supervisor-01 / supervisor-02 / finance-01 / operator-01)的初始口令。
# 真实部署必须覆盖它。
DEMO_PASSWORD=guardrail-demo

# --- 可观测(W7)---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse:4318
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
