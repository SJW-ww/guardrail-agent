# 复制成 .env 即可:cp .env.example .env
# docker compose 会自动读取同目录下的 .env,文件不存在也不会报错。

# --- 应用 ---
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=3000
# 注意:API_PORT 改端口时,NEXT_PUBLIC_API_BASE_URL 要跟着改

# 容器以你的 UID 运行,避免它写出的文件在宿主机上属于 root、删不掉
# 用 `id -u` / `id -g` 确认
HOST_UID=1000
HOST_GID=1000

# --- 数据库 ---
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=guardrail
POSTGRES_DB=guardrail
POSTGRES_PORT=5432
# 本地直接连宿主机
DATABASE_URL=postgresql+asyncpg://guardrail:guardrail@localhost:5432/guardrail
# 容器内互连(compose 会用它覆盖上面的值)
DATABASE_URL_IN_DOCKER=postgresql+asyncpg://guardrail:guardrail@postgres:5432/guardrail

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_URL_IN_DOCKER=redis://redis:6379/0

# --- 前端 ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://api:8000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- 治理层(W2 起启用)---
LEASE_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
MAX_STEP_RETRIES=3

# --- 可观测(W7)---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse:4318
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
